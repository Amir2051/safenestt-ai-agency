# SafeNestT AI Investigation Engine — Secrets
# =============================================
# DO NOT commit this file to Git.
# Copy to .env.secrets and fill in real values.
# In production, use a secret manager (SOPS, Vault, etc.).
#
# REQUIRED — Database
# ---------------------
DB_HOST=127.0.0.1
DB_PORT=54322
DB_NAME=safenestt_ai
DB_USER=safenestt_app
DB_PASSWORD=        # ← Set in production (not 'postgres')
DB_SSL_MODE=disable # ← Set to 'require' in production with TLS

# REQUIRED — API Authentication
# ------------------------------
HERMES_API_KEY=     # ← Server-to-server key registered in engine's api_keys table
HERMES_BASE_URL=http://127.0.0.1:8002

# REQUIRED — Encryption at Rest
# ------------------------------
SAFENESTT_ENCRYPTION_KEY=  # ← Fernet key (32 url-safe base64 bytes)
ENCRYPTION_AT_REST=true

# REQUIRED — API Key Pepper (must match what was used to hash registered keys)
# ----------------------------------------------------------------------------
API_KEY_PEPPER=             # ← Change from default in production

# OPTIONAL — Model Provider
# --------------------------
MODEL_PROVIDER=ollama       # ← 'ollama' or 'openai'
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3:1.7b       # ← Ollama model name

# OPTIONAL — Logging
# --------------------
DB_QUERY_LOG=false          # ← Set to 'true' for debugging only

# Port configuration
HOST=127.0.0.1
PORT=8002
WORKERS=1
